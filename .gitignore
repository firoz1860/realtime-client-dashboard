# ===== Dependencies =====
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===== Environment / secrets (NEVER commit) =====
.env
.env.*
!.env.example
!.env.*.example

# ===== Build output =====
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ===== Prisma =====
# Generated client lives under node_modules (already ignored). Ignore any
# custom generated output or local sqlite dev DBs if present.
prisma/generated/
*.db
*.db-journal

# ===== Logs =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Test / coverage =====
coverage/
.nyc_output/

# ===== Caches =====
.cache/
.eslintcache
.parcel-cache/
*.tgz

# ===== Editor / OS =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ===== Deploy / hosting =====
.vercel/
.render/

# ===== Next.js dev-generated agent files (regenerated by `next dev`) =====
/frontend/AGENTS.md
/frontend/CLAUDE.md

# ===== v0 sandbox internal files =====
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# =============================================================================
# Production hardening (added 2026-09-28)
# -----------------------------------------------------------------------------
# NOTE: *.sql is deliberately NOT ignored. Prisma migrations live at
# backend/prisma/migrations/<name>/migration.sql and MUST stay tracked, or
# `npm run prisma:deploy` has nothing to apply on a fresh deploy.
# =============================================================================

# ===== Key material & certificates (NEVER commit) =====
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.crt
*.cer
*.der
*.asc
*.gpg
*.kdbx
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_*.pub
.ssh/
secrets/
*.secret
*-credentials.json
service-account*.json
gha-creds-*.json

# ===== Extra environment-file shapes not caught by .env / .env.* above =====
*.env
!*.env.example
env.sh
.envrc
.direnv/

# ===== E2E / browser test artifacts =====
.playwright-mcp/
playwright-report/
playwright-results.xml
playwright-results.json
test-results/
blob-report/
playwright/.cache/
playwright/.auth/
cypress/screenshots/
cypress/videos/
/artifacts/

# ===== Agent / assistant machine-local config =====
# .claude/skills/ and .claude/settings.json stay committable (shared tooling);
# only the per-machine permission grants are ignored.
.claude/settings.local.json
**/.claude/settings.local.json
.cursor/
.aider*
.continue/
.gemini/
.codeium/

# ===== Local container & infra overrides =====
