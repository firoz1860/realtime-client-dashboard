{
  "name": "realtime-client-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "audit": "tsx scripts/audit.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "node-cron": "4.2.1",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.36.0",
    "prisma": "6.16.2",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "22.x"
  }
}